# Git LFS：大文件必须走 LFS，否则推送会被 GitHub 拒绝
binaries/*.dll filter=lfs diff=lfs merge=lfs -text
binaries/*.bin filter=lfs diff=lfs merge=lfs -text
binaries/OptiScaler/*.dll filter=lfs diff=lfs merge=lfs -text
# 二进制一律视为二进制，不做行尾转换与文本 diff
*.dll binary
*.bin binary
*.exe binary
*.lib binary
*.obj binary
*.pdb binary
# 文档：统一使用 LF
*.md text eol=lf
*.txt text eol=lf
# 脚本
*.py text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
